ANTHROPIC_API_KEY=

# Kubernetes access (optional overrides — defaults work for a local Kind
# cluster on the ambient kubeconfig, e.g. ~/.kube/config)
# KUBE_NAMESPACE=default
# KUBE_CONTEXT=
# KUBE_KUBECONFIG_PATH=

# RAG (docs search tool) — Voyage AI for embeddings, local Qdrant by default
VOYAGE_API_KEY=
# RAG_EMBEDDING_MODEL=voyage-3.5
# RAG_QDRANT_URL=http://localhost:6333
# RAG_COLLECTION_NAME=k8s_docs

# LangSmith tracing (optional) — the eval harness loads these into the
# process environment so LangChain picks them up. With tracing off, eval
# runs still work; the JSON records in backend/eval/results/ are the log.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=kube-troubleshooting-agent-eval
