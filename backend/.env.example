ANTHROPIC_API_KEY=

# Kubernetes access (optional overrides — defaults work for a local Kind
# cluster on the ambient kubeconfig, e.g. ~/.kube/config)
# KUBE_NAMESPACE=default
# KUBE_CONTEXT=
# KUBE_KUBECONFIG_PATH=

# RAG (docs search tool) — Voyage AI for embeddings, local Qdrant by default
VOYAGE_API_KEY=
# RAG_EMBEDDING_MODEL=voyage-3.5
# RAG_QDRANT_URL=http://localhost:6333
# RAG_COLLECTION_NAME=k8s_docs

# LangSmith tracing (optional). The API and the eval harness each load
# these into the process environment so LangChain picks them up, and each
# traces to its own project so eval runs never mix with real traffic.
# With tracing off everything still works.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=kube-troubleshooting-agent            # the API
# LANGSMITH_EVAL_PROJECT=kube-troubleshooting-agent-eval  # python -m eval

# Conversation memory — SQLite file for the LangGraph checkpointer
# (relative to backend/, created on first start)
# API_CHECKPOINT_DB_PATH=data/checkpoints.db

# Logging — JSON lines for anything that ships logs somewhere; console
# (same fields as key=value) is easier to read while developing.
# LOG_FORMAT=console
# LOG_LEVEL=INFO
